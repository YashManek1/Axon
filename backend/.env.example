# Development defaults — copy to backend/.env and fill in real values.
#
# Production secrets (MONGO_URI, REDIS_URI, JWT_SECRET, ENCRYPTION_KEY,
# DISPATCH_SIGNING_KEY) must be stored in Azure Key Vault and injected via
# Container App secretRef — see docs/deploy-azure.md Steps 2 and 4.
# Never commit plaintext secrets or a .env.production file to git.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB
# Dev (docker-compose): credentials match MONGO_INITDB_ROOT_* in docker-compose.yml.
# Prod: sourced from Key Vault secret MONGO-URI via secretref — no plaintext on disk.
MONGO_URI=mongodb://axon_dev:axon_dev_secret@localhost:27017/axon?authSource=admin

# Redis — use REDIS_URI for production or component vars for local dev
# Prod: sourced from Key Vault secret REDIS-URI via secretref.
REDIS_URI=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT signing key — generate with: openssl rand -hex 32 (min 32 chars)
# Prod: sourced from Key Vault secret JWT-SECRET via secretref.
JWT_SECRET=replace-with-at-least-32-characters-xxxxxxxxxxx

# AES-256-GCM encryption key — exactly 64 hex chars.
# Generate with: openssl rand -hex 32
# Prod: sourced from Key Vault secret ENCRYPTION-KEY via secretref.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 key for signed job dispatch (min 32 hex chars).
# Must match DISPATCH_SIGNING_KEY in the Rust agent environment.
# Generate with: openssl rand -hex 32
# Prod: sourced from Key Vault secret DISPATCH-SIGNING-KEY via secretref.
DISPATCH_SIGNING_KEY=00000000000000000000000000000000

# Email (optional)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# OpenTelemetry (optional) — enable distributed tracing by setting OTEL_EXPORTER_OTLP_ENDPOINT.
# When unset, the OTEL SDK is disabled and all trace calls become no-ops.
# Dev (docker-compose): http://localhost:4317
# Prod: Jaeger or other OTLP-compatible collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: comma-separated key=value headers for OTLP exporter auth.
OTEL_EXPORTER_OTLP_HEADERS=

# Prometheus scrape endpoint bearer token. When set, Prometheus can scrape metrics
# via /admin/metrics/prometheus with Authorization: Bearer <token>.
# Before running docker-compose up, create observability/prometheus/token:
#   echo -n "$PROMETHEUS_BEARER_TOKEN" > observability/prometheus/token
# Dev: use any value, e.g. prometheus
PROMETHEUS_BEARER_TOKEN=

# Grafana admin password. Grafana is exposed on port 3001 (dev) or 127.0.0.1:3001.
# Default user: admin, password: <value of GRAFANA_ADMIN_PASSWORD>
# Change this in production.
GRAFANA_ADMIN_PASSWORD=
